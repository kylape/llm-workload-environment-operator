{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "image",
    "replicaCount",
    "argocd",
    "kueue",
    "crds",
    "resources",
    "imagePullSecrets",
    "nodeSelector",
    "tolerations",
    "affinity",
    "hypershift"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "",
        "coreweave",
        "openshift"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s@]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        }
      }
    },
    "kueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissionEnabled",
        "admissionValidationEnabled",
        "namespaceLabels",
        "configRef"
      ],
      "properties": {
        "admissionEnabled": {
          "type": "boolean"
        },
        "admissionValidationEnabled": {
          "type": "boolean"
        },
        "namespaceLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "not": {
              "enum": [
                "llm.redhat.com/environment"
              ]
            }
          }
        },
        "configRef": {
          "type": "string",
          "pattern": "^[^:\\s]+:[^:\\s]+:[A-Za-z0-9._-]+$"
        }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/quantities"
        },
        "limits": {
          "$ref": "#/definitions/quantities"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "hypershift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "profiles"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "releaseImage",
              "pullSecret",
              "baseDomain",
              "etcdStorageClass",
              "workerStorageClass"
            ],
            "properties": {
              "releaseImage": {
                "type": "string",
                "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
              },
              "baseDomain": {
                "type": "string",
                "minLength": 1
              },
              "apiServerAddress": {
                "type": "string",
                "minLength": 1
              },
              "etcdStorageClass": {
                "type": "string",
                "minLength": 1
              },
              "workerStorageClass": {
                "type": "string",
                "minLength": 1
              },
              "etcdStorageSize": {
                "type": "string",
                "minLength": 1
              },
              "workerMemory": {
                "type": "string",
                "minLength": 1
              },
              "workerRootDisk": {
                "type": "string",
                "minLength": 1
              },
              "clusterNetwork": {
                "type": "string",
                "minLength": 1
              },
              "serviceNetwork": {
                "type": "string",
                "minLength": 1
              },
              "pullSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "name"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "sshKey": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "name"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "workerCores": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "maxReplicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "controlPlaneNodeSelector": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "workerNodeSelector": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "apiServerPublishingStrategy": {
                "type": "string",
                "enum": [
                  "NodePort",
                  "Route",
                  "SharedIngress"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "apiServerPublishingStrategy"
                  ],
                  "properties": {
                    "apiServerPublishingStrategy": {
                      "const": "Route"
                    }
                  }
                },
                "else": {
                  "required": [
                    "apiServerAddress"
                  ]
                }
              }
            ]
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "profiles": {
            "minProperties": 1
          }
        }
      }
    }
  },
  "definitions": {
    "quantities": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    }
  }
}
